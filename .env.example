# =========================================================
# Flask Application Variables
# =========================================================

# API Gateway or backend endpoint used by Flask app
SEARCH_API_URL=https://your-api-gateway-url.amazonaws.com/prod/search-part


# =========================================================
# S3 Sync Service Variables
# =========================================================

# AWS region
AWS_REGION=us-east-1

# S3 bucket used for CSV uploads
S3_BUCKET_NAME=your-s3-bucket-name

# Local file paths
PARTS_LOCAL_PATH=path/to/sample_parts.csv
PLANNERS_LOCAL_PATH=path/to/sample_planners.csv
ADDRESSES_LOCAL_PATH=path/to/sample_site_addresses.csv

# S3 object keys
PARTS_S3_KEY=data/parts.csv
PLANNERS_S3_KEY=data/planners.csv
ADDRESSES_S3_KEY=data/site_addresses.csv

# Local tracking file for upload hash comparison
TRACK_FILE=uploaded_file_hashes.json


# =========================================================
# Geocode Site Address Lambda Variables
# =========================================================

# Redshift configuration
REDSHIFT_DATABASE=your_redshift_database
REDSHIFT_ENDPOINT=your-redshift-endpoint.amazonaws.com
REDSHIFT_WORKGROUP=your-redshift-workgroup
REDSHIFT_USER=your_redshift_username
REDSHIFT_PASSWORD=your_redshift_password
GEOCODE_LAMBDA_NAME=your-geocode-lambda-function-name

# Optional geocoding API key
GEOCODE_API_KEY=your_geocode_api_key


# =========================================================
# Search Part Lambda Variables
# =========================================================

REDSHIFT_DATABASE=your_redshift_database
REDSHIFT_WORKGROUP=your-redshift-workgroup


# =========================================================
# Redshift Stored Procedure Trigger Lambda Variables
# =========================================================

REDSHIFT_DATABASE=your_redshift_database
REDSHIFT_WORKGROUP=your-redshift-workgroup

# Stored procedure used for ETL pipeline
STORED_PROCEDURE=sp_part_transfer_pipeline


# =========================================================
# Slack Bot Handler Variables
# =========================================================

# Slack Lambda function name
LAMBDA_FUNCTION_NAME=your_slack_bot_lambda_name

# Slack credentials
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Public API endpoint used by Slack bot
YOUR_WEBSITE_API_URL=https://your-public-api-url.amazonaws.com/search-part


# =========================================================
# Docker / Flask Runtime Variables (Optional)
# =========================================================

FLASK_APP=app.py
FLASK_ENV=development
PORT=80